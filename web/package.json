{
  "name": "liam-esp",
  "version": "1.0.0",
  "description": "GUI for Liam-ESP",
  "private": true,
  "author": "Henrik Östman",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/trycoon/liam-esp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/trycoon/liam-esp.git"
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "webpack-dev-server --hot --config build/webpack.config.js",
    "build": "rimraf ./dist && NODE_ENV=production webpack --config build/webpack.config.js",
    "lint": "biome lint src mock build",
    "lint:fix": "biome lint --write src mock build",
    "format": "biome format --write src mock build",
    "size-check": "node scripts/check-size.js",
    "build:ci": "npm run build && npm run size-check"
  },
  "homepage": "https://github.com/trycoon/liam-esp",
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "express": "^5.2.1",
    "partysocket": "^1.1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "compression-webpack-plugin": "^12.0.0",
    "cookies": "^0.9.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.9.4",
    "my-local-ip": "^1.0.0",
    "rimraf": "^6.1.3",
    "sass": "^1.93.2",
    "sass-loader": "^17.0.0",
    "style-loader": "^4.0.0",
    "stylelint": "^17.14.1",
    "stylelint-webpack-plugin": "^5.1.0",
    "url-loader": "^4.1.1",
    "webpack": "^5.109.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.0.0",
    "ws": "^8.18.3"
  },
  "allowScripts": {
    "@biomejs/biome@1.9.4": true,
    "@parcel/watcher@2.6.0": true
  }
}
